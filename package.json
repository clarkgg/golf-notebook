{
  "name": "golf-notebook",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.10",
    "expo-haptics": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@expo/metro-runtime": "~57.0.8",
    "@types/node": "^22.20.1",
    "@types/react": "~19.2.2",
    "react-dom": "^19.2.3",
    "react-native-web": "^0.21.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:page": "expo export --platform web && node scripts/build-web-page.mjs",
    "test": "tsc -p tsconfig.test.json && node --test test-build/src/core/core.test.js",
    "typecheck": "tsc --noEmit",
    "inspect": "tsc -p tsconfig.test.json && node test-build/scripts/inspect-hole.js"
